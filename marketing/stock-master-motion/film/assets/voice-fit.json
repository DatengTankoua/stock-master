  "vo": [
    {
      "scene": "s1",
      "text": "Combien reste-t-il de lait de karité en rayon ?",
      "plannedStart": 0.4,
      "plannedEnd": 2.6,
      "start": 0.399,
      "end": 3.038
    },
    {
      "scene": "s1",
      "text": "Qui a vendu quoi aujourd'hui ?",
      "plannedStart": 2.8,
      "plannedEnd": 4.4,
      "start": 3.388,
      "end": 5.24
    },
    {
      "scene": "s1",
      "text": "Avec Stock Master, vous le savez.",
      "plannedStart": 5.4,
      "plannedEnd": 7.4,
      "start": 5.59,
      "end": 8.087
    },
    {
      "scene": "s2",
      "text": "Chez Royal Vibe Cosmétique, chaque produit a sa fiche : sa photo, son prix en francs CFA, son stock.",
      "screen": "Chez RoyalVibe Cosmétique, chaque produit a sa fiche : sa photo, son prix en francs CFA, son stock.",
      "plannedStart": 8.6,
      "plannedEnd": 13.6,
      "start": 8.887,
      "end": 16.582
    },
    {
      "scene": "s2",
      "text": "Et tout est rangé par rayon.",
      "plannedStart": 14.4,
      "plannedEnd": 16.2,
      "start": 16.932,
      "end": 18.571
    },
    {
      "scene": "s3",
      "text": "Une cliente prend une huile d'argan.",
      "plannedStart": 20.6,
      "plannedEnd": 22.6,
      "start": 20.536,
      "end": 22.279
    },
    {
      "scene": "s3",
      "text": "Junior enregistre la vente… et le stock passe de trois à deux.",
      "plannedStart": 23,
      "plannedEnd": 27.2,
      "start": 22.929,
      "end": 26.84
    },
    {
      "scene": "s3",
      "text": "Stock Master signale aussitôt un stock faible.",
      "plannedStart": 28.4,
      "plannedEnd": 31,
      "start": 28.312,
      "end": 31.249
    },
    {
      "scene": "s4",
      "text": "Mireille, la propriétaire, est prévenue.",
      "plannedStart": 35.6,
      "plannedEnd": 37.6,
      "start": 35.49,
      "end": 38.025
    },
    {
      "scene": "s4",
      "text": "C'est elle qui choisit les droits de chacun : vendre, ajuster le stock, voir toutes les ventes.",
      "plannedStart": 40.4,
      "plannedEnd": 46,
      "start": 40.275,
      "end": 46.101
    },
    {
      "scene": "s5",
      "text": "Le réseau coupe ?",
      "plannedStart": 48.6,
      "plannedEnd": 49.8,
      "start": 48.45,
      "end": 49.265
    },
    {
      "scene": "s5",
      "text": "Grâce continue de vendre.",
      "plannedStart": 50.2,
      "plannedEnd": 51.8,
      "start": 50.045,
      "end": 51.825
    },
    {
      "scene": "s5",
      "text": "Au retour de la connexion, la vente est envoyée, une seule fois, et le stock se met à jour.",
      "plannedStart": 56.4,
      "plannedEnd": 61.4,
      "start": 56.226,
      "end": 62.122
    },
    {
      "scene": "s6",
      "text": "Le soir, l'analyse fait le point : le montant des ventes, les produits classés par montant vendu, et les stocks faibles.",
      "plannedStart": 63.6,
      "plannedEnd": 69.6,
      "start": 63.403,
      "end": 70.57
    },
    {
      "scene": "s6",
      "text": "L'historique du mois se télécharge en Excel ou en PDF.",
      "plannedStart": 71,
      "plannedEnd": 74.6,
      "start": 70.92,
      "end": 74.074
    },
    {
      "scene": "s7",
      "text": "Vos produits, vos ventes, votre équipe : tout est au même endroit.",
      "plannedStart": 78,
      "plannedEnd": 81.4,
      "start": 77.759,
      "end": 82.394
    },
    {
      "scene": "s7",
