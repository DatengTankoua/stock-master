# ── Stock Master web — local development ─────────────────────────────────────
# Copy to web/.env.local. Values point to the local API, never to production.
# NEXT_PUBLIC_* and S3_HOSTNAME are read at BUILD time (and when `pnpm dev`
# starts): restart the dev server, or rebuild, after a change.
# REQUIRED: NEXT_PUBLIC_API_URL. Everything else is optional.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# Shows the sign-up page and links (display only: the API decides with
# PUBLIC_REGISTRATION_ENABLED). Exactly `true` to show them.
# NEXT_PUBLIC_REGISTRATION_ENABLED=false

# 1-18C - Cloudflare Turnstile on sign-up: PUBLIC site key (never the
# secret key). Local development: Cloudflare test key 1x00000000000000000000AA.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Local network-free checkbox (tests, recipe); the API refuses simulation
# whenever NODE_ENV=production.
# NEXT_PUBLIC_TURNSTILE_SIMULATED=false

# SEO - optional site verification meta tags. Tokens come from Google Search
# Console (HTML tag, "content" value) and Bing Webmaster Tools
# (msvalidate.01); never invent them. DNS verification of the domain is the
# recommended method and needs no variable.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Image hosts. S3_HOSTNAME (build time): extra https host allowed by
# next.config.ts `images` (local MinIO, http://localhost:9000, is always
# allowed). CSP_IMAGE_ORIGINS (read at runtime by src/proxy.ts): origins of
# signed images in production (R2), comma-separated; not needed locally.
# S3_HOSTNAME=
# CSP_IMAGE_ORIGINS=

# Optional public version shown in support requests.
# NEXT_PUBLIC_APP_VERSION=
